<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClassDailyLand.App</RootNamespace>
    <AssemblyName>ClassDailyLand</AssemblyName>
    <!-- ThemeMode 是 .NET 9 引入的实验性 API，需要抑制 WPF0001 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassDailyLand.Core\ClassDailyLand.Core.csproj" />
    <ProjectReference Include="..\ClassDailyLand.Infrastructure\ClassDailyLand.Infrastructure.csproj" />
    <ProjectReference Include="..\ClassDailyLand.Plugin.Abstractions\ClassDailyLand.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\ClassDailyLand.PluginHost\ClassDailyLand.PluginHost.csproj" />
    <ProjectReference Include="..\ClassDailyLand.Win32\ClassDailyLand.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      同时启用 WPF 与 WinForms 时，SDK 会把 System.Drawing / System.Windows.Forms
      注入全局 using，导致 Application、Brushes、Color、ColorConverter 等
      与 WPF 同名类型冲突。这里移除这两个全局 using（程序集引用仍然保留），
      需要 WinForms 类型的Tray 代码改用显式别名。
    -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!--
      设置中心改用 WebView2 渲染仓库根的 ui/（与 Python 版共用同一份 HTML/CSS）。
      WebView2Loader 是本地库，单文件发布必须靠 Release 分支里的
      IncludeNativeLibrariesForSelfExtract 一起打包，否则 exe 起不来。
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!--
      关闭 WPF Fluent 主题「自动给窗口套 Mica」的行为。
      原因：灵动岛/副岛是无边框透明窗口，自动材质会与之冲突；
      改用 Win32 层在需要时显式应用（见 SettingsWindow.ApplyWindowEffects），
      这样能精确控制哪些窗口带材质、以及在 Win10 上如何降级。
    -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>

  <!--
    设置界面（仓库根的 ui/，与 Python 版共用同一份）随构建落到输出的 ui\ 下。
    运行时由 SettingsWebWindow 用虚拟主机映射加载，找不到时会自动向上逐级查找，
    所以开发态（bin 深处）与发布态（exe 旁边的 ui\）都能跑。
  -->
  <PropertyGroup>
    <SharedUiDir>$(MSBuildThisFileDirectory)..\..\ui\</SharedUiDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(SharedUiDir)index.html" Link="ui\index.html"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SharedUiDir)index-qt.html" Link="ui\index-qt.html"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SharedUiDir)host.js" Link="ui\host.js"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SharedUiDir)lib\*.js" Link="ui\lib\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SharedUiDir)pages\*.js" Link="ui\pages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SharedUiDir)styles\*.css" Link="ui\styles\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布相关的单文件设置。
    WPF 依赖若干原生 DLL（wpfgfx / PresentationNative / D3DCompiler 等），
    默认不会被打进单文件，因此必须显式开启原生库内嵌，
    否则产出的仍是一个 exe 加几个 DLL 的文件夹。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
